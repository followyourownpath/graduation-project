# Browser origin(s), comma-separated.
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_BYTES=20971520
BACKEND_URL=http://localhost:5000

# Safe in a browser only when RLS is correctly configured. Never put the service
# role key in frontend code.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Server-only Azure credentials.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
# Use either KEY1 or KEY2. Keep the other key unused for safe key rotation.
AZURE_DOCUMENT_INTELLIGENCE_KEY=
# Prebuilt model name (for example, prebuilt-layout) or a customer-provided
# custom model ID.
AZURE_DOCUMENT_INTELLIGENCE_MODEL=
# Keep this aligned with the API version supported by the selected model.
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30
# Azure resource location, for example australiaeast. The SDK normally routes
# requests through ENDPOINT; this value is retained for deployment metadata.
AZURE_DOCUMENT_INTELLIGENCE_REGION=
